{
  "name": "timelife",
  "version": "0.1.17",
  "description": "TimeLife — календарь iCloud и виджеты для Windows 11",
  "main": "src/main.cjs",
  "author": {
    "name": "Koda Yorg",
    "email": "kodayorg@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win dir",
    "dist": "npm run legal:prepare && npm run release:check && electron-builder --config build/public.cjs --win nsis && node scripts/check-public-release.cjs --artifacts",
    "legal:prepare": "node scripts/prepare-distribution.cjs",
    "release:check": "node scripts/check-public-release.cjs",
    "dist:preview": "npm run legal:prepare && electron-builder --win nsis"
  },
  "dependencies": {
    "@touch4it/ical-timezones": "1.9.0",
    "fast-xml-parser": "^5.3.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@fontsource/comfortaa": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "acorn": "^8.18.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.calendaru.desktop",
    "productName": "TimeLife",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TimeLife",
      "artifactName": "TimeLife-Preview-${version}.${ext}",
      "license": "distribution/legal/installer-terms.txt"
    },
    "extraResources": [
      {
        "from": "distribution/legal",
        "to": "legal"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kodayorg/TimeLife.git"
  },
  "bugs": {
    "url": "https://github.com/kodayorg/TimeLife/issues"
  }
}
